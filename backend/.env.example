# Environment Configuration
# Copy this file to .env and fill in the values

# Deployment Environment (development / production)
ENV=production

# Base Domain for Stores (e.g., 127.0.0.1.nip.io for local, [IP].nip.io for VPS)
BASE_DOMAIN=[IP].nip.io

# Database Connection String (SQLite for local MVP)
DATABASE_URL=sqlite:///./sql_app.db

# Fallback Password for Demo Stores (Optional)
DEMO_STORE_PASSWORD=StoreSecureRound1!
